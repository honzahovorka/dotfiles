# Machine-local Hyprland state, never tracked. monitors.lua is rewritten in place
# by omarchy-hyprland-monitor-scaling (SUPER + SLASH) and read by
# omarchy-hyprland-monitor-clamshell, so it belongs to the machine, not the repo.
# Per-host settings that *should* be tracked live in hypr/machines/$HOST.lua.
omarchy/.config/hypr/monitors.lua
omarchy/.config/hypr/.luarc.json
omarchy/.config/hypr/*.bak.*
