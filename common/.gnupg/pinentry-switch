#!/bin/sh
# Dispatch to a GUI pinentry when the caller sets PINENTRY_USER_DATA=gui
# (e.g. Neovim/Neogit), otherwise use the inline terminal pinentry.
case "$(uname -s)" in
  Darwin) gui=pinentry-mac tty=pinentry-tty ;;
  *)      gui=/usr/bin/pinentry-qt tty=/usr/bin/pinentry-tty ;;
esac
case "$PINENTRY_USER_DATA" in
  gui) exec "$gui" "$@" ;;
  *)   exec "$tty" "$@" ;;
esac
