#!/usr/bin/env bash

# Wrapper around hyprmon that keeps it out of the dotfiles repo.
#
# hyprmon rewrites whatever file $HYPRLAND_CONFIG points at, and it does so on
# every profile *apply*, not just on save. Left to its own devices it falls back
# to ~/.config/hypr/hyprland.conf -- a stow symlink into this repo, which it
# writes straight through -- so merely moving between desks dirtied the repo.
# Point it at the machine-local, untracked monitors.conf instead.
#
# HYPRLAND_CONFIG is exported for this process only, on purpose: exporting it
# session-wide would also change where Hyprland itself looks for its config.

set -euo pipefail

config="$HOME/.config/hypr/monitors.conf"

# hyprmon reads the target before rewriting it and errors out if it is missing
[[ -f $config ]] ||
    printf '# Monitor layout for this machine. Managed by hyprmon, not tracked in git.\n' >"$config"

export HYPRLAND_CONFIG="$config"

# Resolve the real binary, skipping this wrapper, so /usr/bin and ~/go/bin both work
real=$(type -aP hyprmon | grep -vFx "$HOME/.config/bin/hyprmon" | head -1 || true)
if [[ -z $real ]]; then
    echo "hyprmon is not installed (only this wrapper is on PATH)" >&2
    exit 127
fi

status=0
"$real" "$@" || status=$?

# hyprmon leaves a <target>.bak.<timestamp> behind on every write; keep the 3 newest
ls -1t "$config".bak.* 2>/dev/null | tail -n +4 | xargs -r rm -- || true

exit $status
