[Unit]
Description=Reconnect Bluetooth input devices after resume or login
# Needs BlueZ, the session bus (systemctl --user) and librepods.service to exist,
# all of which arrive with the graphical session.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/bin/bt-resume-reconnect
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
