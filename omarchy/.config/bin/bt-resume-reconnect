#!/bin/bash
# bt-resume-reconnect: get bonded Bluetooth input devices back after suspend
# or login.
#
# librepods (the omapods AirPods plugin) keeps a continuous BLE discovery scan
# running. While it does, the kernel never auto-connects a bonded BLE HID device
# (the MX Master) that wakes up and starts advertising. librepods pauses its
# scan for sleep and restarts it 2 s after wake, so the mouse gets a ~3 s window
# and usually misses it — reconnects then take minutes or never happen.
#
# The same race happens at login: librepods starts with the graphical session
# and is scanning within seconds of the adapter powering up, so a mouse that is
# already awake never gets in either.
#
# This daemon opens a reconnect window once at startup, then watches logind's
# PrepareForSleep signal, the same way omarchy-system-sleep-monitor does, and
# opens another on every wake. In a window it:
#   1. pauses librepods so the kernel's passive scan can accept the mouse the
#      moment it is touched,
#   2. nudges every trusted input device that is still disconnected with a
#      host-initiated `bluetoothctl connect` every CONNECT_EVERY seconds,
#   3. stops as soon as everything is connected, or after WINDOW seconds,
#   4. starts librepods again, only if it was the one that stopped it.
#
# Runs as the bt-resume-reconnect.service user unit. Logs go to the journal:
#   journalctl --user -u bt-resume-reconnect -f
#
# Only a suspend/resume cycle is handled after startup; a Bluetooth adapter
# reset or a librepods restart on their own do not reopen the window.

set -uo pipefail

WINDOW=${BT_RESUME_WINDOW:-180} # seconds to hold the scan-free window
CONNECT_EVERY=5                 # seconds between host-initiated connect attempts
POLL=2                          # seconds between connection checks
SETTLE=2                        # seconds to let BlueZ come back after resume
SCANNER_UNIT=librepods.service  # the unit that owns the permanent BLE scan

log() { printf '%s\n' "$*"; }

# Whether this process stopped SCANNER_UNIT and still owes it a restart. Kept
# global on purpose: the EXIT trap in handle_wake runs after the function's
# locals are gone.
paused=false

# MACs of trusted devices that are HID: BlueZ tags them with an input-* icon,
# and BLE HID also advertises the HID service UUID.
input_devices() {
  local mac
  while read -r _ mac _; do
    [[ -n ${mac:-} ]] || continue
    if bluetoothctl info "$mac" 2>/dev/null |
      grep -qE '^\s*(Icon: input-|UUID: Human Interface Device)'; then
      printf '%s\n' "$mac"
    fi
  done < <(bluetoothctl devices Trusted 2>/dev/null)
}

is_connected() {
  bluetoothctl info "$1" 2>/dev/null | grep -q 'Connected: yes'
}

# Runs in a background subshell per window, so its state is its own.
handle_wake() {
  local start deadline last_connect mac
  local -a devices pending=()

  resume_scanner() {
    if $paused; then
      log "resuming $SCANNER_UNIT"
      systemctl --user start "$SCANNER_UNIT"
      paused=false
    fi
  }
  # A suspend arriving mid-window kills this handler; never leave librepods down.
  trap 'resume_scanner; exit 0' TERM INT
  trap 'resume_scanner' EXIT

  sleep "$SETTLE"

  mapfile -t devices < <(input_devices)
  if ((${#devices[@]} == 0)); then
    log "no trusted input devices, nothing to do"
    return 0
  fi

  for mac in "${devices[@]}"; do
    is_connected "$mac" || pending+=("$mac")
  done
  if ((${#pending[@]} == 0)); then
    log "all input devices already connected, nothing to do"
    return 0
  fi

  if systemctl --user is-active --quiet "$SCANNER_UNIT"; then
    log "pausing $SCANNER_UNIT for up to ${WINDOW}s while ${pending[*]} reconnect"
    systemctl --user stop "$SCANNER_UNIT" && paused=true
  fi

  start=$SECONDS
  deadline=$((start + WINDOW))
  last_connect=$((start - CONNECT_EVERY))
  while ((SECONDS < deadline)); do
    pending=()
    for mac in "${devices[@]}"; do
      is_connected "$mac" || pending+=("$mac")
    done
    if ((${#pending[@]} == 0)); then
      log "all input devices connected $((SECONDS - start))s after wake"
      break
    fi
    if ((SECONDS - last_connect >= CONNECT_EVERY)); then
      for mac in "${pending[@]}"; do
        if timeout 10 bluetoothctl connect "$mac" >/dev/null 2>&1; then
          log "connected $mac by host-initiated connect"
        fi
      done
      last_connect=$SECONDS
    fi
    sleep "$POLL"
  done
  if ((${#pending[@]} > 0)); then
    log "window closed with ${pending[*]} still disconnected"
  fi

  resume_scanner
}

monitor() {
  local line handler_pid=

  # Login is the same race as resume: librepods starts alongside us.
  log "service started, opening reconnect window"
  handle_wake &
  handler_pid=$!

  while IFS= read -r line; do
    case $line in
      *"boolean true"*) # about to suspend
        if [[ -n $handler_pid ]] && kill -0 "$handler_pid" 2>/dev/null; then
          log "suspending mid-window, cancelling wake handler"
          kill "$handler_pid"
          wait "$handler_pid" 2>/dev/null
        fi
        handler_pid=
        ;;
      *"boolean false"*) # resumed
        if [[ -n $handler_pid ]] && kill -0 "$handler_pid" 2>/dev/null; then
          continue
        fi
        log "system resumed, opening reconnect window"
        handle_wake &
        handler_pid=$!
        ;;
    esac
  done < <(exec dbus-monitor --system \
    "type='signal',sender='org.freedesktop.login1',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'")

  # dbus-monitor only exits when the system bus goes away; let systemd restart us.
  return 1
}

case ${1:-} in
  --once)
    # Manual test: behave as if the system just resumed.
    handle_wake
    ;;
  -h | --help)
    echo "usage: bt-resume-reconnect [--once]"
    echo "  (no args)  run a reconnect window now, then another on every resume (logind PrepareForSleep)"
    echo "  --once     run one reconnect window now and exit"
    ;;
  *)
    monitor
    ;;
esac
